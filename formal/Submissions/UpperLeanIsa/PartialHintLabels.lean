def label8N : Nat := 
def label8 (v : BitVec 10) : BitVec 10 :=
  BitVec.ofNat 10 (label8N / 2^(10*v.toNat) % 1024)
def label8InvN : Nat := 
def label8Inv (v : BitVec 10) : BitVec 10 :=
  BitVec.ofNat 10 (label8InvN / 2^(10*v.toNat) % 1024)
theorem label8_left : ∀ v, label8Inv (label8 v) = v := by decide +kernel
theorem label8_right : ∀ v, label8 (label8Inv v) = v := by decide +kernel
def label8Equiv : BitVec 10 ≃ BitVec 10 where
  toFun := label8
  invFun := label8Inv
  left_inv := label8_left
  right_inv := label8_right

def hinted8N : Nat := 0x3800000000000000000000000000000000000e00000000000000000000000000000e000000000000000000000000070000000000000000000000e00000000000000000038000000000000000e0000000000001c0000000000e00000000e000000e00007000e00000007fc01fe
def hinted8 (v : Nat) : Bool := hinted8N / 2^v % 2 == 1
theorem hinted8_correct : ∀ v < 1024, hinted8 v =
    hints8.any (fun r => (label8 (BitVec.ofNat 10 r.2.1)).toNat == v) := by
  decide +kernel
theorem hinted8_zero : hinted8 0 = false := by decide

