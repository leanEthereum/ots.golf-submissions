import Submissions.UpperLeanIsa.LengthFrameChecks

/-! The free-last candidate adds exits with fp=1. These certificates exclude
all such landings in the unchanged group-12 blocks, for every admitted memory
address. They do not by themselves prove the candidate's control-flow theorem. -/
namespace OptimalOTS.FreeLastExitData
open LeanerVM.Parameters OptimalOTS.HLFour
open OptimalOTS.ByteWindow OptimalOTS.LengthFrameChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000
set_option Elab.async false

def check : Nat → List Nat → Bool
  | _, [] => true
  | x, delta :: ds => frameCheck bytePow 0 (entryOf 12 x) 0 5504 delta && check (x+1) ds

theorem check_sound : ∀ ds x, check x ds = true → ∀ i < ds.length,
    ∃ delta, frameCheck bytePow 0 (entryOf 12 (x+i)) 0 5504 delta = true := by
  intro ds
  induction ds with
  | nil => intros; simp_all
  | cons d ds ih =>
    intro x h i hi
    simp only [check, Bool.and_eq_true] at h
    cases i with
    | zero => exact ⟨d, h.1⟩
    | succ i =>
      simpa only [Nat.add_assoc, Nat.add_comm 1 i] using ih (x+1) h.2 i (by simpa using hi)

