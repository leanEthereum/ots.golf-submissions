/-- No first operand of a group-12 block is a valid address in exit frame 1. -/
theorem exit_address_ne {x c j : Nat} (hx : x < 1024)
    (he : entryOf 12 x < 2^18) (hc : c < 2^16) (hj : j < 2^32) :
    gpow c / (gpow (entryOf 12 x) + lengthBias) ≠ gpow j := by
  obtain ⟨delta, hd⟩ := all_checked hx
  have h := frameCheck_address_ne bytePow bytePow_correct hd
    (length_frame_ne_zero he) hc hj
  simpa only [lengthBias, gpow, pow_zero,
    show (BitVec.ofNat 64 0 : K) = 0 from rfl, add_zero, one_mul] using h

