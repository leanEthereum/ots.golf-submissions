import Submissions.UpperLeanIsa.MachineLayout

/-! Shared power certificates for the signature-length guard.
The arithmetic statements and certificates are unchanged from the split development.
Sequential elaboration bounds the live task state within this combined module. -/
namespace OptimalOTS.HLG3.LengthGate
open LeanerVM.Parameters LeanerVM.Semantics
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false

theorem combine {a b c : Nat} {x y z : K}
    (ha : gpow a = x) (hb : gpow b = y)
    (hc : (a + b) % ordG = c) (hz : x * y = z) : gpow c = z := by
  rw [← hc, gpow_mod, ← gpow_mul_gpow, ha, hb, hz]

