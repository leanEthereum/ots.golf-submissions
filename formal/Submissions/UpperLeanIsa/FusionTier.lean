theorem ctq_succ (n : ℕ) : compTableQ uprof ugam 18 85 20 (n + 1) =
    stepQ uprof ugam 18 85 20 n (compTableQ uprof ugam 18 85 20 n) := rfl

theorem tq2 : compTableQ uprof ugam 18 85 20 2 = TQ2 := by decide +kernel

