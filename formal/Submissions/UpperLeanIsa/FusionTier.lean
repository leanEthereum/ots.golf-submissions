    rcases code_mem _ (code_sum_le I) with h0 | h
    · exfalso
      have hc := card_code (∑ u : Fin 13, code u (field u I))
      rw [window_code (code_sum_le I), h0, Finset.card_eq_zero] at hc
      have hm : I ∈ Finset.univ.filter fun I' : Index =>
          params.Accepted I' ∧ ∑ u : Fin 13, code u (field u I') =
            ∑ u : Fin 13, code u (field u I) :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hI, rfl⟩
      rw [hc] at hm
      exact Finset.notMem_empty _ hm
    · obtain ⟨t, ht, hw⟩ := h
      exact ⟨t, ht, hw.symm⟩
  card_weight t ht := by
    obtain ⟨hle, hW, hwe⟩ := code_tier t ht
    change (Finset.univ.filter fun I : Index => params.Accepted I ∧ params.weight I = tA t).card =
      tN t * tA t
    have hset : (Finset.univ.filter fun I : Index =>
        params.Accepted I ∧ params.weight I = tA t) =
        Finset.univ.filter fun I : Index =>
          params.Accepted I ∧ ∑ u : Fin 13, code u (field u I) = eT t := by
      refine Finset.filter_congr fun I _ => ?_
      rw [← hwe]
      constructor
      · rintro ⟨hI, hw⟩
        rw [weight_eq hI, wprod_eq] at hw
        exact ⟨hI, Nat.pow_right_injective (le_refl 2) hw⟩
      · rintro ⟨hI, he⟩
        exact ⟨hI, by rw [weight_eq hI, wprod_eq, he]⟩
    rw [hset, card_code, window_code hle, hW]

end FusionCodec

end OptimalOTS.LeanIsaBaseline.Layer
