def table (i j : Nat) : Nat := packedGet (match i with | 0 => row0 | 1 => row1 | 2 => row2 | 3 => row3 | 4 => row4 | 5 => row5 | _ => 0) j

theorem table_correct (i j : Nat) (hi : i < 6) (hj : j < 2048) :
    table i j = (g^(j*2048^i)).toNat := by
  interval_cases i
  · exact row0_correct j hj
  · exact row1_correct j hj
  · exact row2_correct j hj
  · exact row3_correct j hj
  · exact row4_correct j hj
  · exact row5_correct j hj

def bytePow (n : Nat) : Nat :=
  if n < 2^22 then windowPow table 2 n else windowPow table 6 n

theorem bytePow_correct (n : Nat) (hn : n < 2^64) :
    bytePow n = (gpow n).toNat := by
  unfold bytePow
  split_ifs with hsmall
  · exact windowPow_correct table g 2
      (fun i hi j hj => table_correct i j (by omega) hj) n hsmall
  · exact windowPow_correct table g 6
      (fun i hi j hj => table_correct i j hi hj) n (by omega)
end OptimalOTS.ByteWindow
