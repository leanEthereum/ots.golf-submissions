import Submissions.UpperLeanIsa.ByteWindowCore

namespace OptimalOTS.ByteWindow
open LeanerVM.Parameters OptimalOTS.BF64Fast
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false

def row0 : Nat := 
theorem seed0 : (g^(256^0)).toNat = 2 := by
  rw [OptimalOTS.GenFast.pow_toNat g 64 _ (by decide)]
  rfl
theorem row0_checked : rowCheck 2 row0 256 1 = true := rfl
theorem row0_correct (j : Nat) (hj : j < 256) :
    packedGet row0 j = (g^(j*256^0)).toNat := by
  have h := rowCheck_sound (g^(256^0)) 256 row0 (1 : K)
    (by rw [seed0]; exact row0_checked) j hj
  simpa only [one_mul, ← pow_mul, Nat.mul_comm] using h

