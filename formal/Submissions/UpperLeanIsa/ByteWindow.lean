def table (i j : Nat) : Nat := packedGet
  (match i with | 0 => row0 | 1 => row1 | 2 => row2 | 3 => row3 | 4 => row4 | 5 => row5 | 6 => row6 | 7 => row7 | _ => 0) j

theorem table_correct (i j : Nat) (hi : i < 8) (hj : j < 256) :
    table i j = (g^(j*256^i)).toNat := by
  interval_cases i
  · exact row0_correct j hj
  · exact row1_correct j hj
  · exact row2_correct j hj
  · exact row3_correct j hj
  · exact row4_correct j hj
  · exact row5_correct j hj
  · exact row6_correct j hj
  · exact row7_correct j hj

def bytePow (n : Nat) : Nat :=
  if n < 2^24 then windowPow table 3 n else windowPow table 8 n
theorem bytePow_correct (n : Nat) (hn : n < 2^64) :
    bytePow n = (gpow n).toNat := by
  unfold bytePow
  split_ifs with hsmall
  · exact windowPow_correct table g 3
      (fun i hi j hj => table_correct i j (by omega) hj) n hsmall
  · exact windowPow_correct table g 8 (fun i hi j hj => table_correct i j hi hj) n hn

end OptimalOTS.ByteWindow
