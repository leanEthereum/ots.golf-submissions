theorem scan_step (ns as : List Nat) (t : Nat)
    (hn : t < ns.length) (ha : t < as.length) :
    ((ns.zipWith (· * ·) as).scanl (· + ·) 0).getD (t + 1) 0 =
      ((ns.zipWith (· * ·) as).scanl (· + ·) 0).getD t 0 +
      ns.getD t 0 * as.getD t 0 := by
  have hz : t < (ns.zipWith (· * ·) as).length := by simp; omega
  have hs : t < ((ns.zipWith (· * ·) as).scanl (· + ·) 0).length := by simp; omega
  have hs' : t + 1 < ((ns.zipWith (· * ·) as).scanl (· + ·) 0).length := by simp; omega
  simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hs',
    List.getElem?_eq_getElem hs, List.getElem?_eq_getElem hn,
    List.getElem?_eq_getElem ha, Option.getD_some, List.getElem_succ_scanl,
    List.getElem_zipWith]


theorem tierA_length : tierA.length = 440 := by decide
theorem tierN_length : tierN.length = 440 := by decide

theorem prefix_scan :
    prefixMass = (tierN.zipWith (· * ·) tierA).scanl (· + ·) 0 := by decide +kernel

theorem prefix_step : ∀ t < 440,
    prefixMass.getD (t + 1) 0 = prefixMass.getD t 0 + tN t * tA t := by
  intro t ht
  rw [prefix_scan]
  exact scan_step tierN tierA t (by simpa only [tierN_length] using ht)
    (by simpa only [tierA_length] using ht)

theorem cum_eq_prefix : ∀ t ≤ 440, cum t = prefixMass.getD t 0 := by
  intro t
  induction t with
  | zero => intro _; rfl
  | succ t ih =>
    intro ht
    rw [cum, Finset.sum_range_succ]
    change cum t + tN t * tA t = _
    rw [ih (by omega), ← prefix_step t (by omega)]

open LinearNumeric (prec iterUp iterDn prec_pos pow_le_iterUp iterDn_le_pow)

/-! ## The schedule -/

/-- `⌈prec · η₀⌉` and `⌊prec · η₀⌋`. -/
def etaUp : ℕ := (prec * (2 ^ 66 + 2 ^ 19) + (2 ^ 128 - 2 ^ 19) - 1) / (2 ^ 128 - 2 ^ 19)
def etaDn : ℕ := prec * (2 ^ 66 + 2 ^ 19) / (2 ^ 128 - 2 ^ 19)

/-- `prec · (1 - P_{<t})`, exact. -/
def rest (t : ℕ) : ℕ := prec - (if t ≤ 440 then prefixMass.getD t 0 else cum t) * 2 ^ 129

theorem rest_eq (t : ℕ) : rest t = prec - cum t * 2 ^ 129 := by
  unfold rest
  split_ifs with ht
  · rw [← cum_eq_prefix t ht]
  · rfl

def m0u (t : ℕ) : ℕ := rest t + etaUp
def m0l (t : ℕ) : ℕ := rest t + etaDn

/-- The rarest-cut schedule of the layer-85 mixed-packet split-alias tables. -/
def schedule : Sched where
  T := 440
  K := 127
  a := tA
  N := tN
  Yu t := (iterUp 19 (m0u t) : ℚ) / prec
  Yl t := (iterDn 19 (m0l t) : ℚ) / prec
  yl t := (m0l t : ℚ) / prec
  hp := 2189121718849 / 2 ^ 40 / 2 ^ 127
  k1 := 1094562261779 / 2 ^ 40 / 2 ^ 127
  b0 := 1

/-! ## The conditions -/

theorem cum_le : ∀ t ≤ 440, cum t * 2 ^ 129 ≤ prec := by
  have hp : ∀ t ≤ 440, prefixMass.getD t 0 * 2 ^ 129 ≤ prec := by decide +kernel
  intro t ht
  rw [cum_eq_prefix t ht]
  exact hp t ht

theorem mass_eq (t : ℕ) : schedule.mass t = (cum t : ℚ) / 2 ^ 127 := by
  simp only [Sched.mass, cum, schedule]
  push_cast
  rfl

theorem eta0_le : eta0 ≤ (etaUp : ℚ) / prec := by decide +kernel

theorem le_eta0 : (etaDn : ℚ) / prec ≤ eta0 := by decide +kernel

theorem ybar_eq {t : ℕ} (ht : t ≤ 440) : schedule.ybar t = (rest t : ℚ) / prec + eta0 := by
  rw [Sched.ybar, mass_eq, rest_eq, Nat.cast_sub (cum_le t ht)]
  push_cast
  unfold prec
  ring

theorem ybar_le {t : ℕ} (ht : t ≤ 440) : schedule.ybar t ≤ (m0u t : ℚ) / prec := by
  rw [ybar_eq ht, m0u, Nat.cast_add, add_div]
  linarith [eta0_le]

theorem le_ybar {t : ℕ} (ht : t ≤ 440) : (m0l t : ℚ) / prec ≤ schedule.ybar t := by
  rw [ybar_eq ht, m0l, Nat.cast_add, add_div]
  linarith [le_eta0]

theorem ybar_nonneg {t : ℕ} (ht : t ≤ 440) : 0 ≤ schedule.ybar t :=
  (div_nonneg (Nat.cast_nonneg _) prec_pos.le).trans (le_ybar ht)

/-- `(1 - P_{<T}) ^ (2 ^ 19 - 1) ≤ 2 ^ -128`, from `2 ^ 19` outward squarings and one division. -/
theorem avail : (1 - schedule.mass 440) ^ (2 ^ 19 - 1) ≤ 1 / 2 ^ 128 := by
  set x := 1 - schedule.mass 440 with hx
  have hxe : x = (rest 440 : ℚ) / prec := by
    rw [hx, mass_eq, rest_eq, Nat.cast_sub (cum_le 440 le_rfl)]
    push_cast
    unfold prec
    ring
  have hpos : 0 < x := by
    rw [hxe]
    exact div_pos (by exact_mod_cast (show 0 < rest 440 by decide +kernel)) prec_pos
  have hU := pow_le_iterUp hpos.le (le_of_eq hxe) 19
  have hsplit : x ^ 2 ^ 19 = x ^ (2 ^ 19 - 1) * x := by
    rw [← pow_succ]; norm_num
  rw [hsplit] at hU
  have hq : (iterUp 19 (rest 440) : ℚ) / prec / ((rest 440 : ℚ) / prec) ≤ 1 / 2 ^ 128 := by
    decide +kernel
  calc x ^ (2 ^ 19 - 1) ≤ (iterUp 19 (rest 440) : ℚ) / prec / x := by
        rw [le_div_iff₀ hpos]; exact hU
    _ ≤ 1 / 2 ^ 128 := by rw [hxe]; exact hq

theorem bounded_adjacent_lt {N : ℕ} {f : ℕ → ℕ}
    (h : ∀ n, n + 1 < N → f n < f (n + 1))
    {s t : ℕ} (hst : s < t) (ht : t < N) : f s < f t := by
  induction t generalizing s with
  | zero => omega
  | succ t ih =>
    by_cases he : s = t
    · subst s
      exact h t ht
    · exact lt_trans (ih (by omega) (by omega)) (h t ht)

theorem positive_lower : ∀ t < 440, 0 < m0l t := by decide +kernel
theorem H_check : schedule.Hprime ≤ schedule.hp := by decide +kernel
theorem post_check : schedule.kpost ≤ schedule.k1 := by decide +kernel
theorem SC_check : schedule.SCf ≤ 2 * 2 ^ 19 * schedule.k1 := by decide +kernel

abbrev LinearConditions := LinearNumeric.LinearConditions

/-- The layer-85 schedule meets the linear numeric conditions. -/
theorem schedule_linear_conditions : LinearConditions schedule where
  K_le := by decide
  T_le := by decide
  a_pos := by decide +kernel
  a_lt := by
    have h : ∀ t < 439, tA t < tA (t + 1) := by decide +kernel
    intro s t hst ht
    exact bounded_adjacent_lt (N:=440) (fun n hn => h n (by omega)) hst ht
  mass_lt := by decide +kernel
  Yu_ge := fun t ht => pow_le_iterUp (ybar_nonneg ht) (ybar_le ht) 19
  Yl_le := fun t ht => iterDn_le_pow (le_ybar ht) 19
  yl_pos := by
    intro t ht
    have h := positive_lower
    exact div_pos (by exact_mod_cast h t ht) prec_pos
  yl_le := fun t ht => le_ybar ht.le
  hp_ge := H_check
  k1_post := post_check
  k1_sc := SC_check
  fresh_index_charge := by decide +kernel
  linear_budget := by decide +kernel
  avail := avail
  acc_le := by rw [mass_eq]; decide +kernel

end OptimalOTS.LeanIsaBaseline.Layer.SplitNumeric
