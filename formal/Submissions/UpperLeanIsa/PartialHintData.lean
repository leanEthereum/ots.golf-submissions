import Submissions.UpperLeanIsa.TriangularHints
import Submissions.UpperLeanIsa.IndexPrimitives
import Submissions.UpperLeanIsa.GenOrderFast

/-! Concrete masks for two partial hints, checked independently of the
unfinished machine port. The existing unit-11 mask is preserved. -/
namespace OptimalOTS.PartialHints
open LeanerVM.Parameters
abbrev Word := BitVec 128
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option exponentiation.threshold 100000

def selector8 (x : Word) : BitVec 10 := x.extractLsb' 64 4 ++ x.extractLsb' 37 6
def selector9 (x : Word) : BitVec 10 := x.extractLsb' 0 10

def mask8N : Nat := 
def mask8V (v : Nat) : Nat := mask8N / 2^(64*v) % 2^64
def mask8 (v : Nat) : Word := BitVec.ofNat 128 (mask8V v)
theorem mask8N_lt : mask8N < 2^(64*64) := by decide +kernel
theorem mask8_outside {v : Nat} (hv : 64 ≤ v) : mask8V v = 0 := by
  have h : mask8N < 2^(64*v) := mask8N_lt.trans_le
    (Nat.pow_le_pow_right (by decide) (by omega))
  simp only [mask8V, Nat.div_eq_of_lt h, Nat.zero_mod]
theorem mask8V_lt (v : Nat) : mask8V v < 2^64 := Nat.mod_lt _ (by positivity)
theorem mask8_selectors_checked : ∀ v < 64,
    LeanIsaBaseline.Layer.hintField (mask8 v) = 0 ∧ selector8 (mask8 v) = 0 := by decide +kernel
theorem mask8_selectors (v : Nat) :
    LeanIsaBaseline.Layer.hintField (mask8 v) = 0 ∧ selector8 (mask8 v) = 0 := by
  by_cases hv : v < 64
  · exact mask8_selectors_checked v hv
  · have hz := mask8_outside (by omega : 64 ≤ v)
    simp [mask8, hz, LeanIsaBaseline.Layer.hintField, selector8, selector9]

