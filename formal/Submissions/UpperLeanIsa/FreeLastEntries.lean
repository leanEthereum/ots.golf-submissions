def normalEntries : Nat → List Nat
  | 0 => normal0_
  | 1 => normal1_
  | 2 => normal2_
  | 3 => normal3_
  | 4 => normal4_
  | 5 => normal5_
  | 6 => normal6_
  | 7 => normal7_
  | 8 => normal8_
  | 9 => normal9_
  | 10 => normal10_
  | 11 => normal11_
  | 12 => normal12_
  | _ => []

def normalEntry (u v : Nat) : Nat := (normalEntries u).getD v 0

def zeroEntry (v : Nat) : Nat := zero_.getD v 0

def freeEntry (s : Nat) : Nat := free_.getD (s-1) 0

theorem normal_checked {u : Nat} (hu : u < 13) : check (fun v => Body.group u v false) 0 (normalEntries u) = true := by
  interval_cases u
  · exact normal0__checked
  · exact normal1__checked
  · exact normal2__checked
  · exact normal3__checked
  · exact normal4__checked
  · exact normal5__checked
  · exact normal6__checked
  · exact normal7__checked
  · exact normal8__checked
  · exact normal9__checked
  · exact normal10__checked
  · exact normal11__checked
  · exact normal12__checked


theorem normal_length {u : Nat} (hu : u < 13) : (normalEntries u).length = VF u := by
  interval_cases u <;> simp only [normalEntries, normal0__length, normal1__length, normal2__length, normal3__length, normal4__length, normal5__length, normal6__length, normal7__length, normal8__length, normal9__length, normal10__length, normal11__length, normal12__length, VF] <;> decide

theorem normal_entry {u v : Nat} (hu : u < 13) (hv : v < VF u) :
    Entry (normalEntry u v) (.group u v false) := by
  have h := check_sound _ _ 0 (normal_checked hu) (by rwa [normal_length hu] : v < (normalEntries u).length)
  simpa only [normalEntry, Nat.zero_add] using h

theorem zero_entry {v : Nat} (hv : v < VF 1) : Entry (zeroEntry v) (.group 1 v true) := by
  have hi : v < zero_.length := by rw [zero__length]; exact hv
  simpa only [zeroEntry, Nat.zero_add] using check_sound _ _ 0 zero__checked hi

theorem free_entry {s : Nat} (hs : 1 ≤ s) (hs' : s ≤ 63) : Entry (freeEntry s) (.free s) := by
  have hi : s-1 < free_.length := by rw [free__length]; omega
  have he : 1+(s-1) = s := by omega
  simpa only [freeEntry,he] using check_sound _ _ 1 free__checked hi

end OptimalOTS.FreeLastEntries
