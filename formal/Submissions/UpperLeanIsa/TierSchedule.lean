open scoped Classical

/-! ## The tier schedule of the classes

Every multiplicity is a power of two, `muT s c = 2 ^ gam s c`, so the weight of a class is
`2 ^ e` for the code sum `e` of its fields. A two-statistic table (`compTableQ`) counts the
accepted field tuples by code sum, which certifies the tier counts of `g1281Sched`. -/

namespace Group3

open Tier

/-- Multiplicity codes of each cost: `muT s c = 2 ^ gam s c`. -/
def shCode (s : ℕ) : List ℕ := if s = 2 then [0, 1, 3, 1] else []

/-- The multiplicity code of cost `c` of shape `s`. -/
def gam (s c : ℕ) : ℕ := (shCode s).getD c 0

/-- The multiplicity code of entry `v` of unit `u`. -/
def code (u v : ℕ) : ℕ := gam (ushape u) (cost u v)

theorem mu_facts : ∀ s < 4, ∀ c < nb s, muT s c = 2 ^ gam s c := by decide +kernel

/-- The largest code of each unit (`18` in all). -/
def gmax (u : ℕ) : ℕ := [0, 0, 0, 0, 0, 0, 0, 3, 3, 3, 3, 3, 3].getD u 0

theorem gam_le : ∀ u < 13, ∀ c < nb (ushape u), gam (ushape u) c ≤ gmax u := by decide +kernel

theorem cost_lt_nb {u v : ℕ} : cost u v < nb (ushape u) := by
  unfold cost costS
  split_ifs with h
  · exact (band_spec (ushape_lt u) h).2.2
  · exact nb_pos (ushape_lt u)

theorem wprod_eq (I : Index) : wprod I = 2 ^ (∑ u : Fin 13, code u (field u I)) := by
  unfold wprod mult code
  rw [← Finset.prod_pow_eq_pow_sum]
  exact Finset.prod_congr rfl fun u _ => mu_facts _ (ushape_lt u) _ cost_lt_nb

theorem code_sum_le (I : Index) : ∑ u : Fin 13, code u (field u I) ≤ 18 := by
  calc _ ≤ ∑ u : Fin 13, gmax u :=
        Finset.sum_le_sum fun u _ => gam_le u u.isLt _ cost_lt_nb
    _ = 18 := by decide

/-- Accepted indices by code sum. -/
theorem card_code (e : ℕ) :
    (Finset.univ.filter fun I : Index =>
        params.Accepted I ∧ ∑ u : Fin 13, code u (field u I) = e).card =
      ∑ s ∈ Finset.Ico 25 89, compQ cut cost code 13 s e := by
  rw [← card_windowQ]
  refine Finset.card_bij' (fun I hI => fun u => ⟨field u I, by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, accepted_iff] at hI
      exact (not_dummy_iff I).mp hI.1.1 u u.isLt⟩)
    (fun c _ => indexOf (fun u => Fin.castLE (cut_le u u.isLt) (c u))) ?_ ?_ ?_ ?_
  · intro I hI
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, accepted_iff, gsum_eq] at hI ⊢
    exact ⟨hI.1.2.1, hI.1.2.2, hI.2⟩
  · intro c hc
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, accepted_iff, gsum_eq] at hc ⊢
    simp only [field_indexOf, Fin.val_castLE]
    refine ⟨⟨(not_dummy_iff _).mpr fun u hu => ?_, hc.1, hc.2.1⟩, hc.2.2⟩
    have := field_indexOf (fun u => Fin.castLE (cut_le u u.isLt) (c u)) ⟨u, hu⟩
    simp only [Fin.val_castLE] at this
    rw [this]
    exact (c ⟨u, hu⟩).isLt
  · intro I _
    exact indexOf_fields I
  · intro c _
    funext u
    exact Fin.ext ((field_indexOf _ u).trans (Fin.val_castLE _ _))

/-- Values of unit `n` of cost `c`. -/
def uprof (n c : ℕ) : ℕ := AS (ushape n) (c + 1) - AS (ushape n) c

/-- The code of cost `c` in unit `n`. -/
def ugam (n c : ℕ) : ℕ := gam (ushape n) c

theorem compQ_rec : ∀ n < 13, ∀ s e, compQ cut cost code (n + 1) s e =
    ∑ c ∈ Finset.range 17, if c ≤ s ∧ ugam n c ≤ e then
      uprof n c * compQ cut cost code n (s - c) (e - ugam n c) else 0 := by
  intro n hn s e
  have hs := ushape_lt n
  have hN : cut n = AS (ushape n) 17 := (AS_ge (nb_le hs)).symm
  exact compQ_succ_band _ _ _ (AS (ushape n)) (AS_mono hs) (AS_zero hs) (gam (ushape n)) 17 n hN
    (fun v hv => cost_spec (by rw [hN]; exact hv)) (fun _ _ => rfl) s e

/-- The window sum of a table row. -/
def winSum (row : List ℕ) : ℕ := ((List.range 64).map fun i => row.getD (25 + i) 0).sum

