import Submissions.UpperLeanIsa.LengthLogValues

/-! Finite coverage and out-of-range bounds for the loader-length logarithms.
The 5504-bit target has ten short logarithmic differences. These aliases are
enumerated explicitly; the machine must rule out each of their cell values.
Sequential elaboration bounds the live task state within this combined module. -/
namespace OptimalOTS.HLG3.LengthGate128
open OptimalOTS.HLG3.LengthGate
open LeanerVM.Parameters LeanerVM.Semantics
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false

/-- Every invalid loader length that still addresses memory, at ONE = cell 48. -/
def aliases : List (Nat × Nat) :=
  [(43,41), (86,42), (172,43), (344,44), (688,45), (1376,46),
   (2752,47), (917,105), (1834,106), (3668,107)]

def Good (p : Nat × Nat) : Prop :=
  gpow p.2 = (BitVec.ofNat 64 p.1 : K) ∧ p.2 < ordG ∧
    (p.1 = 5504 ∨ 2^32 ≤ (p.2 + ordG - 1434881718044321323 + 48) % ordG ∨
      (p.1, (p.2 + ordG - 1434881718044321323 + 48) % ordG) ∈ aliases)

/-- The Boolean form of the range and alias conditions of `Good`, scanned once per block. -/
def rangeB (p : Nat × Nat) : Bool :=
  Nat.blt p.2 ordG &&
    (Nat.beq p.1 5504 ||
      Nat.ble 4294967296 ((p.2 + ordG - 1434881718044321323 + 48) % ordG) ||
      aliases.any (fun q => Nat.beq q.1 p.1 &&
        Nat.beq q.2 ((p.2 + ordG - 1434881718044321323 + 48) % ordG)))

theorem rangeB_spec {p : Nat × Nat} (h : rangeB p = true) :
    p.2 < ordG ∧ (p.1 = 5504 ∨ 2^32 ≤ (p.2 + ordG - 1434881718044321323 + 48) % ordG ∨
      (p.1, (p.2 + ordG - 1434881718044321323 + 48) % ordG) ∈ aliases) := by
  simp only [rangeB, Bool.and_eq_true, Bool.or_eq_true, Nat.blt_eq, Nat.beq_eq, Nat.ble_eq,
    List.any_eq_true] at h
  obtain ⟨h1, h2⟩ := h
  refine ⟨h1, ?_⟩
  rcases h2 with (h2 | h2) | ⟨q, hq, hq1, hq2⟩
  · exact Or.inl h2
  · exact Or.inr (Or.inl h2)
  · refine Or.inr (Or.inr ?_)
    have hqe : q = (p.1, (p.2 + ordG - 1434881718044321323 + 48) % ordG) := Prod.ext hq1 hq2
    exact hqe ▸ hq

theorem logs_nil : ∀ p ∈ ([] : List (Nat × Nat)), gpow p.2 = (BitVec.ofNat 64 p.1 : K) := by
  simp

/-- Logarithm certificates of a list, one entry at a time without rewriting the list. -/
theorem logs_cons {p : Nat × Nat} {ps : List (Nat × Nat)}
    (h1 : gpow p.2 = (BitVec.ofNat 64 p.1 : K))
    (h3 : ∀ q ∈ ps, gpow q.2 = (BitVec.ofNat 64 q.1 : K)) :
    ∀ q ∈ p :: ps, gpow q.2 = (BitVec.ofNat 64 q.1 : K) := by
  intro q hq
  rcases List.mem_cons.mp hq with rfl | hq
  · exact h1
  · exact h3 q hq

theorem good_of_all {ps : List (Nat × Nat)}
    (h1 : ∀ q ∈ ps, gpow q.2 = (BitVec.ofNat 64 q.1 : K)) (h2 : ps.all rangeB = true) :
    ∀ p ∈ ps, Good p := fun p hp =>
  ⟨h1 p hp, rangeB_spec (List.all_eq_true.mp h2 p hp)⟩

