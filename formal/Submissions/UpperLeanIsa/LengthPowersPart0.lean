theorem combine {a b c : Nat} {x y z : K}
    (ha : gpow a = x) (hb : gpow b = y)
    (hc : (a + b) % ordG = c) (hz : x * y = z) : gpow c = z := by
  rw [← hc, gpow_mod, ← gpow_mul_gpow, ha, hb, hz]

