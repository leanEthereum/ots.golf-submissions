namespace OptimalOTS.LeanIsaBaseline.Layer.SplitTables
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option Elab.async false

abbrev Entry := List ℕ × ℕ × ℕ
def dim (u : ℕ) : ℕ := if u = 5 ∨ u = 6 then 4 else 3
def hidden (u : ℕ) : ℕ := if u = 6 then 2 else if u = 11 ∨ u = 12 then 1 else 0
def visible (u : ℕ) : ℕ := dim u - hidden u
def binding (u : ℕ) : Bool := !(1 ≤ u && u ≤ 4) && u != 7
def zeroCount (t : List ℕ) : ℕ := (t.filter (· == 0)).length
def bits (u : ℕ) : ℕ := [9, 9, 9, 9, 9, 12, 11, 10, 10, 10, 10, 9, 10].getD u 0
def budget (u : ℕ) : ℕ := [6, 7, 7, 7, 7, 5, 6, 7, 7, 7, 7, 6, 6].getD u 0

