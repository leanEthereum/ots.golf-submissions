private theorem from_block (ps : List (Nat × Nat)) {entry s : Nat}
    (hc : ps.map Prod.fst = List.range' entry 68)
    (hg : ps.all (goodRow entry) = true)
    (hlo : entry ≤ s) (hhi : s < entry + 68) (hne : s ≠ entry) :
    ∃ d, freeCheck s entry d = true := by
  have hmem : s ∈ ps.map Prod.fst := by
    rw [hc, List.mem_range']
    exact ⟨s - entry, by omega, by omega⟩
  obtain ⟨⟨s', d⟩, hp, he⟩ := List.mem_map.mp hmem
  change s' = s at he
  subst s'
  refine ⟨d, ?_⟩
  have h := List.all_eq_true.mp hg (s, d) hp
  simpa only [goodRow, if_neg hne] using h

